# Server
PORT=8787
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Onshape stack and API version
ONSHAPE_BASE_URL=https://cad.onshape.com
ONSHAPE_API_VERSION=v17

# Authentication mode: auto | api-key | api-key-signature | oauth | bearer | none
# auto chooses signed API key, OAuth, bearer, or none based on configured credentials.
# Use api-key only for local testing; use api-key-signature for private/internal service use.
ONSHAPE_AUTH=auto

# API-key credentials. Keep secrets in .env, never in browser code.
# ONSHAPE_AUTH=api-key uses Basic Authorization for local testing.
# ONSHAPE_AUTH=api-key-signature signs every request and re-signs redirects.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# Proper embedded-app mode. Register these in Onshape Developer Settings.
ONSHAPE_OAUTH_CLIENT_ID=
ONSHAPE_OAUTH_CLIENT_SECRET=
ONSHAPE_OAUTH_CALLBACK_URL=https://your-host.example/oauth/callback
ONSHAPE_OAUTH_URL=https://oauth.onshape.com

# Optional temporary bearer-token mode.
ONSHAPE_BEARER_TOKEN=

# Native Insert image sketch entities use internal serialized fields.
# Leave writes disabled until you have tested in a disposable copy of a document.
ENABLE_NATIVE_IMAGE_WRITE=false

# Maximum uploaded image size in bytes (25 MiB).
MAX_IMAGE_UPLOAD_BYTES=26214400

# Optional manual-update feed; empty disables network checks. Restart after changes.
UPDATE_CHECK_URL=

# Policy switches are managed in the app and saved to settings.json beside .env.
# SESSION_SECRET is not used; session IDs and CSRF tokens are generated at runtime.

# Where JSON backups are written before each feature update.
BACKUP_DIR=./backups
